  },
  "homepage": "https://github.com/khleeq92-netizen/FullPageScreenshot_Screen_Recorder#readme",
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "mediabunny": "^1.66.5"
  },
  "private": true,
  "type": "module"
